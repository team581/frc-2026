{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    "schedule:daily"
  ],
  "customManagers": [{
    "customType": "jsonata",
    "datasourceTemplate": "custom.wpilib-vendordep",
    "managerFilePatterns": ["**/vendordeps/*.json"],
    "fileFormat": "json",
    "matchStrings": ["jsonUrl ? { \"depName\": name, \"currentValue\": version, \"registryUrl\": jsonUrl }"]
  }],
  "timezone": "America/Los_Angeles",
  "packageRules": [{
    "groupName": "error-prone",
    "matchSourceUrls": ["https://github.com/google/error-prone"]
  }],
  "semanticCommits": "disabled",
  "labels": ["dependencies"],
  "customDatasources": {"wpilib-vendordep": {
    "defaultRegistryUrlTemplate": "{{registryUrl}}",
    "format": "json",
    "transformTemplates": ["{ \"releases\": [{ \"version\": version }] }"]
  }}
}
